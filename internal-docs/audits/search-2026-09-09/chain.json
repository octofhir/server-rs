  "params": "[Text(\"% smith%\")]",
  "sql": "SELECT r.resource::text, r.id, r.txid, r.created_at, r.updated_at FROM \"public\".\"observation\" AS r WHERE EXISTS (SELECT 1 FROM \"patient\" chain0 WHERE (chain0.status != 'deleted' AND EXISTS (SELECT 1 FROM jsonb_array_elements(CASE WHEN jsonb_typeof(r.resource->'subject') = 'array' THEN r.resource->'subject' WHEN r.resource->'subject' IS NULL THEN '[]'::jsonb ELSE jsonb_build_array(r.resource->'subject') END) ref WHERE (ref->>'reference' = 'Patient/' || chain0.id OR ref->>'reference' LIKE '%/Patient/' || chain0.id)) AND fhir_text_blob(fhir_s_patient_family(chain0.resource)) LIKE $1)) AND r.status != 'deleted' LIMIT 12"
}