  "params": "[Text(\"Patient\"), Text(\"{p-10}\")]",
  "sql": "SELECT DISTINCT s.resource::text,s.id,s.txid,s.created_at,s.updated_at FROM observation s WHERE s.status != 'deleted' AND EXISTS(SELECT 1 FROM jsonb_array_elements(CASE WHEN jsonb_typeof(s.resource->'subject') = 'array' THEN s.resource->'subject' WHEN s.resource->'subject' IS NOT NULL AND s.resource->'subject' != 'null'::jsonb THEN jsonb_build_array(s.resource->'subject') ELSE '[]'::jsonb END) ref CROSS JOIN LATERAL (SELECT regexp_match(ref->>'reference', '([A-Za-z]+)/([A-Za-z0-9.-]{1,64})$') AS m) x WHERE x.m[1]=$1 AND x.m[2]=ANY($2::text[]))"
