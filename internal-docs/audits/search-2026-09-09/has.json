  "params": "[Json(\"{\\\"code\\\":\\\"8480-6\\\",\\\"system\\\":\\\"http://loinc.org\\\"}\"), Json(\"{\\\"coding\\\":[{\\\"code\\\":\\\"8480-6\\\",\\\"system\\\":\\\"http://loinc.org\\\"}]}\")]",
  "sql": "SELECT r.resource::text, r.id, r.txid, r.created_at, r.updated_at FROM \"public\".\"patient\" AS r WHERE EXISTS (SELECT 1 FROM \"observation\" has0 WHERE (has0.status != 'deleted' AND EXISTS (SELECT 1 FROM jsonb_array_elements(CASE WHEN jsonb_typeof(has0.resource->'subject') = 'array' THEN has0.resource->'subject' WHEN has0.resource->'subject' IS NULL THEN '[]'::jsonb ELSE jsonb_build_array(has0.resource->'subject') END) ref WHERE (ref->>'reference' = 'Patient/' || r.id OR ref->>'reference' LIKE '%/Patient/' || r.id)) AND (has0.resource->'code' @> $1::jsonb OR has0.resource->'code' @> $2::jsonb))) AND r.status != 'deleted' LIMIT 12"
