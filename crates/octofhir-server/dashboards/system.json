{
  "id": "system",
  "title": "System",
  "description": "Throughput, latency, errors, FHIR interactions, database, runtime and resources of this deployment's instances.",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "variables": [
    {
      "name": "instance",
      "label": "instance",
      "labelName": "instance",
      "metric": "up",
      "multi": true,
      "includeAll": true
    }
  ],
  "panels": [
    {
      "id": "row-overview",
      "title": "Overview",
      "type": "row",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": "throughput",
      "title": "Throughput",
      "type": "stat",
      "description": "Requests per second, all routes and instances",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "unit": "reqps",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(octofhir_http_requests_total{instance=~\"$instance\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "id": "p95",
      "title": "p95 latency",
      "type": "stat",
      "description": "95th percentile of request latency, all routes",
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "unit": "s",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(octofhir_http_request_duration_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))"
        }
      ],
      "thresholds": [
        {
          "value": 0.25,
          "color": "warning"
        },
        {
          "value": 1,
          "color": "error"
        }
      ]
    },
    {
      "id": "errors",
      "title": "Server errors",
      "type": "stat",
      "description": "Share of requests answered with 5xx",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "unit": "percentunit",
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(octofhir_http_requests_total{status_class=\"5xx\",instance=~\"$instance\"}[$__rate_interval])) or vector(0)) / sum(rate(octofhir_http_requests_total{instance=~\"$instance\"}[$__rate_interval]))"
        }
      ],
      "thresholds": [
        {
          "value": 0.01,
          "color": "warning"
        },
        {
          "value": 0.05,
          "color": "error"
        }
      ]
    },
    {
      "id": "inflight",
      "title": "In flight",
      "type": "stat",
      "description": "Requests being served right now",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "unit": "short",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(octofhir_http_active_connections{instance=~\"$instance\"})"
        }
      ],
      "decimals": 0
    },
    {
      "id": "up",
      "title": "Instances up",
      "type": "stat",
      "description": "Instances Prometheus scraped successfully",
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "unit": "short",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{instance=~\"$instance\"})"
        }
      ],
      "decimals": 0
    },
    {
      "id": "uptime",
      "title": "Uptime",
      "type": "stat",
      "description": "Since the most recent (re)start of any instance",
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "unit": "s",
      "targets": [
        {
          "refId": "A",
          "expr": "min(time() - octofhir_process_start_time_seconds{instance=~\"$instance\"})"
        }
      ]
    },
    {
      "id": "row-http",
      "title": "HTTP",
      "type": "row",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": "throughput-status",
      "title": "Throughput by status",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "unit": "reqps",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_class) (rate(octofhir_http_requests_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legend": "{{status_class}}"
        }
      ],
      "drawStyle": "bars",
      "stack": true,
      "colors": {
        "2xx": "neutral",
        "3xx": "info",
        "4xx": "warning",
        "5xx": "error"
      }
    },
    {
      "id": "latency",
      "title": "Latency",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "unit": "s",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(octofhir_http_request_duration_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
          "legend": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(octofhir_http_request_duration_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
          "legend": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(octofhir_http_request_duration_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
          "legend": "p99"
        }
      ],
      "description": "Request latency percentiles, all routes",
      "colors": {
        "p50": "neutral",
        "p95": "accent",
        "p99": "warning"
      }
    },
    {
      "id": "throughput-instance",
      "title": "Throughput by instance",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "unit": "reqps",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(octofhir_http_requests_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legend": "{{instance}}"
        }
      ]
    },
    {
      "id": "p95-instance",
      "title": "p95 latency by instance",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "unit": "s",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (instance, le) (rate(octofhir_http_request_duration_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
          "legend": "{{instance}}"
        }
      ]
    },
    {
      "id": "row-fhir",
      "title": "FHIR",
      "type": "row",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": "fhir-interactions",
      "title": "Interactions",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "unit": "reqps",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (interaction) (rate(octofhir_fhir_interactions_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legend": "{{interaction}}"
        }
      ],
      "description": "FHIR REST interactions per second (read, search, create, \u2026)",
      "drawStyle": "bars",
      "stack": true
    },
    {
      "id": "fhir-p95",
      "title": "p95 latency by interaction",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "unit": "s",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (interaction, le) (rate(octofhir_fhir_interaction_duration_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
          "legend": "{{interaction}}"
        }
      ]
    },
    {
      "id": "fhir-table",
      "title": "Resource types",
      "type": "table",
      "description": "Each resource type and interaction over the selected time range",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (resource_type, interaction) (rate(octofhir_fhir_interactions_total{instance=~\"$instance\"}[$__range]))",
          "legend": "Req/s",
          "unit": "reqps"
        },
        {
          "refId": "B",
          "expr": "sum by (resource_type, interaction) (increase(octofhir_fhir_interactions_total{instance=~\"$instance\"}[$__range]))",
          "legend": "Count",
          "unit": "short"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.5, sum by (resource_type, interaction, le) (rate(octofhir_fhir_interaction_duration_seconds_bucket{instance=~\"$instance\"}[$__range])))",
          "legend": "p50",
          "unit": "s"
        },
        {
          "refId": "D",
          "expr": "histogram_quantile(0.95, sum by (resource_type, interaction, le) (rate(octofhir_fhir_interaction_duration_seconds_bucket{instance=~\"$instance\"}[$__range])))",
          "legend": "p95",
          "unit": "s"
        },
        {
          "refId": "E",
          "expr": "sum by (resource_type, interaction) (rate(octofhir_fhir_interactions_total{status_class=~\"4xx|5xx\",instance=~\"$instance\"}[$__range])) / sum by (resource_type, interaction) (rate(octofhir_fhir_interactions_total{instance=~\"$instance\"}[$__range]))",
          "legend": "Errors",
          "unit": "percentunit"
        }
      ]
    },
    {
      "id": "row-routes",
      "title": "Routes",
      "type": "row",
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": "routes",
      "title": "Routes",
      "type": "table",
      "description": "Each HTTP route over the selected time range",
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method, path) (rate(octofhir_http_requests_total{instance=~\"$instance\"}[$__range]))",
          "legend": "Req/s",
          "unit": "reqps"
        },
        {
          "refId": "B",
          "expr": "sum by (method, path) (increase(octofhir_http_requests_total{instance=~\"$instance\"}[$__range]))",
          "legend": "Requests",
          "unit": "short"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.5, sum by (method, path, le) (rate(octofhir_http_request_duration_seconds_bucket{instance=~\"$instance\"}[$__range])))",
          "legend": "p50",
          "unit": "s"
        },
        {
          "refId": "D",
          "expr": "histogram_quantile(0.95, sum by (method, path, le) (rate(octofhir_http_request_duration_seconds_bucket{instance=~\"$instance\"}[$__range])))",
          "legend": "p95",
          "unit": "s"
        },
        {
          "refId": "E",
          "expr": "histogram_quantile(0.99, sum by (method, path, le) (rate(octofhir_http_request_duration_seconds_bucket{instance=~\"$instance\"}[$__range])))",
          "legend": "p99",
          "unit": "s"
        },
        {
          "refId": "F",
          "expr": "sum by (method, path) (rate(octofhir_http_requests_total{status_class=\"5xx\",instance=~\"$instance\"}[$__range])) / sum by (method, path) (rate(octofhir_http_requests_total{instance=~\"$instance\"}[$__range]))",
          "legend": "5xx",
          "unit": "percentunit"
        }
      ]
    },
    {
      "id": "row-db",
      "title": "Database",
      "type": "row",
      "gridPos": {
        "x": 0,
        "y": 54,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": "db-size",
      "title": "Database size",
      "type": "stat",
      "description": "Size of the PostgreSQL database",
      "gridPos": {
        "x": 0,
        "y": 55,
        "w": 4,
        "h": 4
      },
      "unit": "bytes",
      "targets": [
        {
          "refId": "A",
          "expr": "max(octofhir_pg_database_size_bytes)"
        }
      ]
    },
    {
      "id": "db-busy",
      "title": "Connections busy",
      "type": "stat",
      "description": "Client connections running a query or holding a transaction open",
      "gridPos": {
        "x": 4,
        "y": 55,
        "w": 4,
        "h": 4
      },
      "unit": "short",
      "targets": [
        {
          "refId": "A",
          "expr": "max(sum by (instance) (octofhir_pg_connections{state=~\"active|idle in transaction.*\"}))"
        }
      ],
      "decimals": 0
    },
    {
      "id": "db-cache-hit",
      "title": "PG cache hit",
      "type": "stat",
      "description": "Data blocks served from PostgreSQL's shared buffers instead of disk",
      "gridPos": {
        "x": 8,
        "y": 55,
        "w": 4,
        "h": 4
      },
      "unit": "percentunit",
      "targets": [
        {
          "refId": "A",
          "expr": "max(rate(octofhir_pg_blocks_total{source=\"cache\"}[$__rate_interval])) / (max(rate(octofhir_pg_blocks_total{source=\"cache\"}[$__rate_interval])) + max(rate(octofhir_pg_blocks_total{source=\"disk\"}[$__rate_interval])))"
        }
      ],
      "thresholds": [
        {
          "value": 0,
          "color": "error"
        },
        {
          "value": 0.9,
          "color": "warning"
        },
        {
          "value": 0.99,
          "color": "success"
        }
      ]
    },
    {
      "id": "storage-p95",
      "title": "Storage p95",
      "type": "stat",
      "description": "95th percentile of a storage (database) call",
      "gridPos": {
        "x": 12,
        "y": 55,
        "w": 4,
        "h": 4
      },
      "unit": "s",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(octofhir_storage_operation_duration_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))"
        }
      ],
      "thresholds": [
        {
          "value": 0.05,
          "color": "warning"
        },
        {
          "value": 0.25,
          "color": "error"
        }
      ]
    },
    {
      "id": "db-locks",
      "title": "Waiting on locks",
      "type": "stat",
      "description": "Connections blocked waiting for a lock",
      "gridPos": {
        "x": 16,
        "y": 55,
        "w": 4,
        "h": 4
      },
      "unit": "short",
      "targets": [
        {
          "refId": "A",
          "expr": "max(octofhir_pg_connections_waiting_on_locks)"
        }
      ],
      "thresholds": [
        {
          "value": 1,
          "color": "warning"
        },
        {
          "value": 5,
          "color": "error"
        }
      ],
      "decimals": 0
    },
    {
      "id": "db-longest-tx",
      "title": "Longest transaction",
      "type": "stat",
      "description": "Age of the oldest open transaction; long ones hold back vacuum",
      "gridPos": {
        "x": 20,
        "y": 55,
        "w": 4,
        "h": 4
      },
      "unit": "s",
      "targets": [
        {
          "refId": "A",
          "expr": "max(octofhir_pg_longest_transaction_seconds)"
        }
      ],
      "thresholds": [
        {
          "value": 30,
          "color": "warning"
        },
        {
          "value": 300,
          "color": "error"
        }
      ]
    },
    {
      "id": "storage-latency",
      "title": "Storage latency by operation",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 59,
        "w": 12,
        "h": 8
      },
      "unit": "s",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (operation, le) (rate(octofhir_storage_operation_duration_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
          "legend": "{{operation}}"
        }
      ],
      "description": "p95 of storage calls by operation; tx_* run inside a transaction"
    },
    {
      "id": "storage-rate",
      "title": "Storage calls",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 59,
        "w": 12,
        "h": 8
      },
      "unit": "ops",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation) (rate(octofhir_storage_operation_duration_seconds_count{instance=~\"$instance\"}[$__rate_interval]))",
          "legend": "{{operation}}"
        }
      ],
      "description": "Storage calls per second by operation",
      "drawStyle": "bars",
      "stack": true
    },
    {
      "id": "db-connections",
      "title": "PG connections by state",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 67,
        "w": 8,
        "h": 8
      },
      "unit": "short",
      "targets": [
        {
          "refId": "A",
          "expr": "max by (state) (octofhir_pg_connections)",
          "legend": "{{state}}"
        }
      ],
      "description": "Client connections to the database, all instances together",
      "stack": true,
      "min": 0,
      "colors": {
        "active": "accent",
        "idle": "neutral",
        "idle in transaction": "warning",
        "idle in transaction (aborted)": "error"
      }
    },
    {
      "id": "db-transactions",
      "title": "Transactions",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 67,
        "w": 8,
        "h": 8
      },
      "unit": "ops",
      "targets": [
        {
          "refId": "A",
          "expr": "max by (outcome) (rate(octofhir_pg_transactions_total[$__rate_interval]))",
          "legend": "{{outcome}}"
        },
        {
          "refId": "B",
          "expr": "max(rate(octofhir_pg_deadlocks_total[$__rate_interval]))",
          "legend": "deadlocks"
        }
      ],
      "description": "Commits and rollbacks per second, and deadlocks",
      "min": 0,
      "colors": {
        "commit": "neutral",
        "rollback": "warning",
        "deadlocks": "error"
      }
    },
    {
      "id": "db-rows",
      "title": "Rows",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 67,
        "w": 8,
        "h": 8
      },
      "unit": "ops",
      "targets": [
        {
          "refId": "A",
          "expr": "max by (operation) (rate(octofhir_pg_rows_total{operation=~\"fetched|inserted|updated|deleted\"}[$__rate_interval]))",
          "legend": "{{operation}}"
        }
      ],
      "description": "Rows fetched, inserted, updated and deleted per second",
      "min": 0
    },
    {
      "id": "dbpool",
      "title": "DB connections",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 75,
        "w": 8,
        "h": 8
      },
      "unit": "short",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (octofhir_db_pool_connections_active{instance=~\"$instance\"})",
          "legend": "{{instance}} in use"
        },
        {
          "refId": "B",
          "expr": "sum(octofhir_db_pool_connections_max{instance=~\"$instance\"})",
          "legend": "pool size"
        }
      ],
      "description": "PostgreSQL connections in use; the pool size is the ceiling",
      "min": 0,
      "colors": {
        "pool size": "neutral"
      }
    },
    {
      "id": "cache-ratio",
      "title": "Cache hit ratio",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 75,
        "w": 8,
        "h": 8
      },
      "unit": "percentunit",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tier) (rate(octofhir_cache_hits_total{instance=~\"$instance\"}[$__rate_interval])) / scalar(sum(rate(octofhir_cache_hits_total{instance=~\"$instance\"}[$__rate_interval])) + sum(rate(octofhir_cache_misses_total{instance=~\"$instance\"}[$__rate_interval])))",
          "legend": "{{tier}}"
        }
      ],
      "description": "Resource cache hits out of lookups, by tier (L1 local, L2 Redis)",
      "min": 0,
      "max": 1
    },
    {
      "id": "cache-ops",
      "title": "Cache lookups",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 75,
        "w": 8,
        "h": 8
      },
      "unit": "ops",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(octofhir_cache_hits_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legend": "hits"
        },
        {
          "refId": "B",
          "expr": "sum(rate(octofhir_cache_misses_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legend": "misses"
        }
      ],
      "drawStyle": "bars",
      "stack": true,
      "colors": {
        "hits": "success",
        "misses": "warning"
      }
    },
    {
      "id": "db-tables",
      "title": "Tables",
      "type": "table",
      "description": "PostgreSQL tables: size with indexes, estimated rows, rows awaiting vacuum",
      "gridPos": {
        "x": 0,
        "y": 83,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (table) (octofhir_pg_table_size_bytes)",
          "legend": "Size",
          "unit": "bytes"
        },
        {
          "refId": "B",
          "expr": "max by (table) (octofhir_pg_table_rows)",
          "legend": "Rows",
          "unit": "short"
        },
        {
          "refId": "C",
          "expr": "max by (table) (octofhir_pg_table_dead_rows)",
          "legend": "Dead rows",
          "unit": "short"
        },
        {
          "refId": "D",
          "expr": "max by (table) (octofhir_pg_table_dead_rows) / (max by (table) (octofhir_pg_table_rows) + max by (table) (octofhir_pg_table_dead_rows))",
          "legend": "Dead share",
          "unit": "percentunit"
        }
      ]
    },
    {
      "id": "storage-slowest",
      "title": "Storage calls",
      "type": "table",
      "description": "Storage calls by operation and resource type over the selected time range",
      "gridPos": {
        "x": 0,
        "y": 93,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation, resource_type) (rate(octofhir_storage_operation_duration_seconds_count{instance=~\"$instance\"}[$__range]))",
          "legend": "Calls/s",
          "unit": "ops"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.5, sum by (operation, resource_type, le) (rate(octofhir_storage_operation_duration_seconds_bucket{instance=~\"$instance\"}[$__range])))",
          "legend": "p50",
          "unit": "s"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.95, sum by (operation, resource_type, le) (rate(octofhir_storage_operation_duration_seconds_bucket{instance=~\"$instance\"}[$__range])))",
          "legend": "p95",
          "unit": "s"
        },
        {
          "refId": "D",
          "expr": "sum by (operation, resource_type) (rate(octofhir_storage_operation_duration_seconds_count{outcome=\"error\",instance=~\"$instance\"}[$__range])) / sum by (operation, resource_type) (rate(octofhir_storage_operation_duration_seconds_count{instance=~\"$instance\"}[$__range]))",
          "legend": "Errors",
          "unit": "percentunit"
        }
      ]
    },
