        {
          "refId": "A",
          "expr": "sum by (instance) (rate(octofhir_tokio_worker_busy_seconds_total{instance=~\"$instance\"}[$__rate_interval])) / sum by (instance) (octofhir_tokio_workers{instance=~\"$instance\"})",
          "legend": "{{instance}}"
